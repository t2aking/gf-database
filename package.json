{
  "name": "gf-database",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first game catalog, inventory manager, and MCP server.",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:api": "tsx watch src/server/index.ts",
    "start:api": "tsx src/server/index.ts",
    "mcp": "sh scripts/run-mcp.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed:sample": "tsx src/database/seed-sample.ts",
    "check:data": "sh scripts/check-public-data.sh --all",
    "check": "vp check && pnpm check:data",
    "test": "vp test",
    "build": "vp build",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@voidzero-dev/vite-plus-core": "0.3.2",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.11.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.19.0"
}
